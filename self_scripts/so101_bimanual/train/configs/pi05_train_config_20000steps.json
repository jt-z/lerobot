{
  "dataset": {
    "repo_id": "hellozjt/cap_pen_and_put_into_holder",
    "root": "/home/ksa/.cache/huggingface/lerobot/hellozjt/cap_pen_and_put_into_holder",
    "revision": "main",
    "streaming": false
  },
  "policy": {
    "type": "pi05",
    "device": "cuda",
    "dtype": "bfloat16",
    "compile_model": false,
    "gradient_checkpointing": true,
    "freeze_vision_encoder": true,
    "train_expert_only": false,
    "push_to_hub": false,
    "empty_cameras": 0,
    "input_features": {
      "observation.images.base_0_rgb": {
        "type": "VISUAL",
        "shape": [3, 224, 224]
